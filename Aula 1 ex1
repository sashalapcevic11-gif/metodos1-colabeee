import math
import numpy as np
import matplotlib.pyplot as plt

#valor verdadeiro
u=2.71828182846

#critério de parada
n=4
eppara= 0.5*10**(2-n)
print(eppara)

def mac(x,i):
  return (x**n)/math.factorial(n)

x=1
i=0
ept=100
soma=0
I=[]
SOMA=[]
EPT=[]

while ept>eppara:
  soma=soma+ mac(x,i)
  ept=abs((u-soma)/u)*100

  I.append(i)
  EPT.append(ept)
  SOMA.append(soma)

  i=i+1

#graficos

plt.plot(I,SOMA,'--or',label='soma das serie')
plt.legend()
plt.grid()
plt.xlabel('itineracao')
plt.ylabel('soma')
plt.show

plt.plot(I,EPT,'--or',label='erro')
plt.legend()
plt.grid()
plt.xlabel('itineracao')
plt.ylabel('soma')
plt.show



