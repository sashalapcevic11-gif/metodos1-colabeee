import math
import matplotlib.pyplot as plt
import numpy as np

def f(x):
  return math.exp(-x)-x

def df(x):
  return -math.exp(-x)-1

def xn(x):
  return x-(f(x)/df(x))

xold=0
epest=100
n=6
eppara=0.5*10**(2-n)

while epest>eppara:
  xnew=xn(xold)
  epest=abs((xold-xnew)/xnew)*100
  xold=xnew


print(xnew)
