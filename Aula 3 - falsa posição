import math
import matplotlib.pyplot as plt
import numpy as np

def f(x):
  return (x**2)-2

def xr(xu,xl):
  return xu-f(xu)*(xl-xu)/(f(xl)-f(xu))

x=np.linspace(-2,2,20)

for i in range(0,19):

  if f(x[i])*f(x[i+1])<0:
    xu=x[i+1]
    xl=x[i]

    eppest=100
    n=6
    eppara= 0.5*10**(2-n)
    xv=xr(xu,xl)

    while eppest>eppara:
      xold=xv

      if f(xv)*f(xu)<0:
        xl=xv

      else:
        xu=xv

      xv=xr(xu,xl)

      eppest=abs((xv-xold)/xv)*100

    print(xv)





