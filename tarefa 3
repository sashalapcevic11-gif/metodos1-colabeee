import matplotlib.pyplot as plt
import math
import numpy as np

#grafico

def f(x):
  return -1.5*x**6 -2*x**4 +12*x

x=np.linspace(-10,10,50)

plt.plot(x,f(x),'--or')
plt.title('Grafico 1')
plt.grid()
plt.legend()
plt.xlabel('valores de x')
plt.ylabel('valores de f(x)')
plt.show()


#interpolação

def calcularx4(x1,x2,x3):
  num = ((x2-x1)**2 * (f(x2)-f(x3))) - ((x2-x3)**2 * (f(x2)-f(x1)))
  den = ((x2-x1)*(f(x2)-f(x3))) - ((x2-x3) * (f(x2)-f(x1)))
  x4=x2- ((1/2)*num/den)
  return x4

x1old=0
x2old=1
x3old=2
x4old= calcularx4(x1old,x2old,x3old)

eppest=100
n=6
eppara=0.5*10**(2-n)

while eppest>eppara:
  x1=x1old
  x2=x2old
  x3=x3old

  if f(x4old)<f(x2old):
    x1=x2old
    x2=x4old
  else:
    x3=x4old
  
  x4new=calcularx4(x1,x2,x3)

  eppest=abs((x4new-x4old)/x4new)*100

  x1old=x1
  x2old=x2
  x3old=x3
  x4old=x4new

print("o valor de x é:",x4new)
print("o valor do erro é:",eppest)

