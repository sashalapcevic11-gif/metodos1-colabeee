import math
import matplotlib.pyplot as plt
import numpy as np

def f(i):
  return 1/i**4

u = (math.pi**4)/90
soma=0
SOMA=[]
EPT=[]
I=[]

for i in range(1,10):
  soma=soma+f(i)
  ept=abs((soma-u)/u)*100
  SOMA.append(soma)
  EPT.append(ept)
  I.append(i)
  i+=1

plt.plot(I,SOMA,'--or', label='Estimativa')
plt.legend( )
plt.grid()
plt.title('soma')
plt.xlabel('itineracoes')
plt.ylabel('soma')
plt.show()

plt.plot(I,EPT,'--or', label='erros')
plt.legend( )
plt.grid()
plt.title('erros')
plt.xlabel('itineracoes')
plt.ylabel('ept')
plt.show()

